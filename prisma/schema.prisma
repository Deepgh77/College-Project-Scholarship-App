generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  STUDENT
  COLLEGE
  AUTHORITY
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CasteCategory {
  OPEN
  OBC
  SC
  ST
  VJNT
  SBC
  EWS
}

enum DocumentType {
  INCOME_CERT
  CASTE_CERT
  DOMICILE_CERT
  MARKSHEET_PREV
  FEE_RECEIPT
  RATION_CARD
  DISABILITY_CERT
  OTHER
}

enum DocumentStatus {
  AVAILABLE
  NEEDS_UPDATE
  NEEDS_CORRECTION
}

enum RuleOperator {
  LTE
  GTE
  EQ
  NEQ
  IN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_COLLEGE_REVIEW
  COLLEGE_SENT_BACK
  COLLEGE_REJECTED
  FORWARDED_TO_AUTHORITY
  UNDER_AUTHORITY_REVIEW
  AUTHORITY_SENT_BACK
  AUTHORITY_REJECTED
  RESUBMITTED_TO_COLLEGE
  APPROVED
  PAYMENT_PROCESSING
  PAYMENT_INITIATED
  DISBURSED
  UNDISBURSED
  CANCELLED
  RIGHT_TO_GIVE_UP
}

enum ReviewerRole {
  COLLEGE
  AUTHORITY
}

enum ReviewDecision {
  VERIFY_FORWARD
  SEND_BACK
  REJECT
  APPROVE
}

enum CorrectionSection {
  PERSONAL
  ACADEMIC
  FINANCIAL
  DOCUMENT
  ELIGIBILITY
}

enum RejectionCategory {
  INCORRECT_DOCUMENT
  EXPIRED_DOCUMENT
  INFORMATION_MISMATCH
  ELIGIBILITY_NOT_MET
  UNREADABLE_DOCUMENT
  ACADEMIC_INCORRECT
  OTHER
}

enum CorrectionStatus {
  OPEN
  RESOLVED_BY_STUDENT
  ACCEPTED
  RE_FLAGGED
}

enum PaymentBatchStatus {
  PREPARED
  PROCESSING
  DISBURSED
  FAILED
}

enum PaymentRecordStatus {
  PENDING
  PROCESSING
  INITIATED
  DISBURSED
  UNDISBURSED
}

enum GrievanceCategory {
  APPLICATION
  DOCUMENT
  VERIFICATION
  PAYMENT
  TECHNICAL
  OTHER
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum GrievanceAssignedRole {
  COLLEGE
  AUTHORITY
  ADMIN
}

enum NotificationCategory {
  ACTION_REQUIRED
  STATUS_UPDATE
  PAYMENT
  GRIEVANCE
  SYSTEM
}

enum ActorRole {
  STUDENT
  COLLEGE
  AUTHORITY
  ADMIN
  SYSTEM
}

// =============================================================================
// IDENTITY & INSTITUTIONAL MASTER MODELS
// =============================================================================

model User {
  id           String   @id @default(uuid())
  // Note: email must be normalized to lowercase in application services prior to create/update
  email        String   @unique
  passwordHash String
  role         UserRole
  collegeId    String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  college            College?              @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studentProfile     StudentProfile?
  notifications      Notification[]
  auditLogs          ApplicationAuditLog[]
  reviews            ApplicationReview[]
  resolvedGrievances Grievance[]           @relation("GrievanceResolver")

  @@index([role])
  @@index([collegeId])
  @@index([departmentId])
}

model College {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  university String
  district   String
  taluka     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  users    User[]
  students StudentProfile[]

  @@index([district])
  @@index([name])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users          User[]
  scholarships   Scholarship[]
  paymentBatches PaymentBatch[]
}

// =============================================================================
// STUDENT PROFILE & DOCUMENT VAULT
// =============================================================================

model StudentProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  fullName              String?
  dob                   DateTime?
  gender                Gender?
  category              CasteCategory?
  religion              String?
  isHandicapped         Boolean        @default(false)
  disabilityPercentage  Int?
  mobile                String?
  address               String?        @db.Text
  state                 String?
  district              String?
  taluka                String?
  cityVillage           String?
  pincode               String?
  collegeId             String?
  courseName            String?
  courseYear            Int?
  admissionYear         Int?
  previousQualification String?
  previousPercentage    Decimal?       @db.Decimal(5, 2)
  annualFamilyIncome    Decimal?       @db.Decimal(12, 2)
  guardianName          String?
  bankAccountNo         String?
  bankIfsc              String?
  bankName              String?
  completionPercentage  Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relationships
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  college        College?        @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  documents      Document[]
  applications   Application[]
  paymentRecords PaymentRecord[]
  grievances     Grievance[]

  @@index([collegeId])
  @@index([category])
}

model Document {
  id           String         @id @default(uuid())
  studentId    String
  documentType DocumentType
  status       DocumentStatus @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  student  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([studentId, documentType])
  @@index([studentId])
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  versionNumber    Int
  originalFilename String
  storagePath      String
  fileSizeBytes    Int
  mimeType         String
  isCompressed     Boolean  @default(false)
  uploadedAt       DateTime @default(now())

  // Relationships
  document             Document                       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  applicationSnapshots ApplicationDocumentSnapshot[]
  resolvedCorrections  ApplicationCorrectionRequest[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// =============================================================================
// SCHOLARSHIP SCHEME & CONFIGURATION MODELS
// =============================================================================

model Scholarship {
  id                   String   @id @default(uuid())
  departmentId         String
  code                 String
  academicYear         String
  name                 String
  description          String   @db.Text
  benefitAmount        Decimal  @db.Decimal(10, 2)
  applicationStartDate DateTime
  applicationEndDate   DateTime
  isFreshAllowed       Boolean  @default(true)
  isRenewalAllowed     Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relationships
  department        Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rules             ScholarshipRule[]
  requiredDocuments ScholarshipRequiredDoc[]
  applications      Application[]

  @@unique([code, academicYear])
  @@index([departmentId])
  @@index([academicYear])
}

model ScholarshipRule {
  id                String       @id @default(uuid())
  scholarshipId     String
  ruleGroup         String       @default("DEFAULT")
  fieldPath         String
  operator          RuleOperator
  targetValue       Json
  failureReasonText String       @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relationships
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, ruleGroup, fieldPath, operator])
  @@index([scholarshipId])
}

model ScholarshipRequiredDoc {
  id             String       @id @default(uuid())
  scholarshipId  String
  documentType   DocumentType
  isMandatory    Boolean      @default(true)
  helpTitle      String
  helpTextSimple String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relationships
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, documentType])
  @@index([scholarshipId])
}

// =============================================================================
// APPLICATION & IMMUTABILITY SNAPSHOT MODELS
// =============================================================================

model Application {
  id                    String            @id @default(uuid())
  applicationNumber     String?           @unique
  studentId             String
  scholarshipId         String
  academicYear          String
  status                ApplicationStatus @default(DRAFT)
  isRenewal             Boolean           @default(false)
  previousApplicationId String?
  healthScore           Int               @default(0)
  draftDataJson         Json?
  submittedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relationships
  student             StudentProfile                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  scholarship         Scholarship                    @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  previousApplication Application?                   @relation("RenewalChain", fields: [previousApplicationId], references: [id], onDelete: SetNull)
  renewedApplications Application[]                  @relation("RenewalChain")
  snapshots           ApplicationSnapshot[]
  documentSnapshots   ApplicationDocumentSnapshot[]
  reviews             ApplicationReview[]
  correctionRequests  ApplicationCorrectionRequest[]
  auditLogs           ApplicationAuditLog[]
  paymentRecord       PaymentRecord?
  grievances          Grievance[]

  @@unique([studentId, scholarshipId, academicYear])
  @@index([studentId])
  @@index([scholarshipId])
  @@index([status])
  @@index([academicYear])
}

model ApplicationSnapshot {
  id               String   @id @default(uuid())
  applicationId    String
  cycleNumber      Int
  // Expected JSON structure for snapshotDataJson:
  // {
  //   "student": { "personal": { ... }, "contact": { ... }, "academic": { ... }, "financial": { ... }, "bank": { ... } },
  //   "questionnaireResponses": { ... },
  //   "scholarshipConfig": { "code": "...", "name": "...", "academicYear": "...", "benefitAmount": "..." },
  //   "eligibilityEvaluation": { "isEligible": true, "evaluatedRules": [ ... ] }
  // }
  snapshotDataJson Json
  submittedAt      DateTime @default(now())

  // Relationships
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, cycleNumber])
  @@index([applicationId])
}

model ApplicationDocumentSnapshot {
  id                String       @id @default(uuid())
  applicationId     String
  cycleNumber       Int
  documentVersionId String
  documentType      DocumentType
  createdAt         DateTime     @default(now())

  // Relationships
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, cycleNumber, documentType])
  @@index([applicationId])
  @@index([documentVersionId])
}

// =============================================================================
// REVIEW & STRUCTURED CORRECTION MODELS
// =============================================================================

model ApplicationReview {
  id             String         @id @default(uuid())
  applicationId  String
  cycleNumber    Int
  reviewerUserId String
  reviewerRole   ReviewerRole
  decision       ReviewDecision
  checklistJson  Json
  overallRemarks String         @db.Text
  reviewedAt     DateTime       @default(now())

  // Relationships
  application        Application                    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerUser       User                           @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  correctionRequests ApplicationCorrectionRequest[]

  @@index([applicationId])
  @@index([reviewerUserId])
}

model ApplicationCorrectionRequest {
  id                        String            @id @default(uuid())
  applicationId             String
  reviewId                  String
  cycleNumber               Int
  reviewerRole              ReviewerRole
  affectedSection           CorrectionSection
  affectedField             String?
  affectedDocumentType      DocumentType?
  rejectionCategory         RejectionCategory
  reasonText                String            @db.Text
  actionRequiredText        String            @db.Text
  status                    CorrectionStatus  @default(OPEN)
  studentResponseText       String?           @db.Text
  resolvedDocumentVersionId String?
  createdAt                 DateTime          @default(now())
  resolvedAt                DateTime?
  reviewedAt                DateTime?

  // Relationships
  application             Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  review                  ApplicationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  resolvedDocumentVersion DocumentVersion?  @relation(fields: [resolvedDocumentVersionId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([reviewId])
  @@index([status])
}

// =============================================================================
// SIMULATED PAYMENT / BENEFIT DISBURSEMENT MODELS
// =============================================================================

model PaymentBatch {
  id                String             @id @default(uuid())
  batchNumber       String             @unique
  departmentId      String
  academicYear      String
  status            PaymentBatchStatus @default(PREPARED)
  totalApplications Int                @default(0)
  totalAmount       Decimal            @default(0) @db.Decimal(14, 2)
  initiatedAt       DateTime?
  disbursedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relationships
  department Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  records    PaymentRecord[]

  @@index([departmentId])
  @@index([academicYear])
}

model PaymentRecord {
  id                  String              @id @default(uuid())
  applicationId       String              @unique
  // Note: Backend services must enforce that studentId equals applicationId.studentId
  studentId           String
  batchId             String?
  amount              Decimal             @db.Decimal(10, 2)
  status              PaymentRecordStatus @default(PENDING)
  // Explicitly simulated reference: e.g. SIM-2026-000042 (no real UTR/DBT implied)
  simulationReference String?             @unique
  failureReason       String?
  disbursedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relationships
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch       PaymentBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([batchId])
  @@index([status])
}

// =============================================================================
// SUPPORT, AUDIT & NOTIFICATION MODELS
// =============================================================================

model Grievance {
  id               String                @id @default(uuid())
  ticketNumber     String                @unique
  studentId        String
  applicationId    String?
  category         GrievanceCategory
  subject          String
  description      String                @db.Text
  attachmentPath   String?
  status           GrievanceStatus       @default(OPEN)
  assignedRole     GrievanceAssignedRole
  resolutionNotes  String?               @db.Text
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relationships
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application    Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  resolvedByUser User?          @relation("GrievanceResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([assignedRole])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  message   String               @db.Text
  category  NotificationCategory
  actionUrl String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ApplicationAuditLog {
  id             String             @id @default(uuid())
  applicationId  String
  actorUserId    String
  actorRole      ActorRole
  action         String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  remarks        String?            @db.Text
  ipAddress      String?
  timestamp      DateTime           @default(now())

  // Relationships
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUser   User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, timestamp])
  @@index([actorUserId])
}
